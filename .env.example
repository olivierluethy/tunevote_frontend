# Copy this file to `.env` and fill in real values.
# All client-facing vars MUST be VITE_-prefixed — they are bundled into the
# built JS and are therefore PUBLIC. Never put server secrets here.

# Base URL of the tunevote_api backend (note: several core files still
# hardcode https://api.tunevote.com/ — see README).
VITE_API_URL=http://localhost:4000

# YouTube Data API v3 key, used for song search.
# Restrict it by HTTP referrer in the Google Cloud console.
VITE_YOUTUBE_KEY=your_youtube_data_api_v3_key

# Google Analytics measurement ID (optional).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
